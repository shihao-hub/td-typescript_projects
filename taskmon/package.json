{
  "name": "taskmon",
  "version": "0.2.1",
  "description": "Windows 任务管理器·内存版：按进程名分组展示内存占用，控制台实时刷新",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts/tsconfig.json",
    "exe": "bun scripts/build-exe.ts",
    "use": "bun scripts/use-latest-exe.ts",
    "release": "bun scripts/build-exe.ts --tag && bun scripts/use-latest-exe.ts",
    "clean-release": "bun scripts/clean-release.ts"
  },
  "bin": {
    "taskmon": "dist/main.js"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rotating-file-stream": "^3.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
