{
  "name": "text-extractor",
  "description": "提取页面元素文本，弹窗编辑并一键复制",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "load": "wxt build && bun scripts/load-into-chrome.ts",
    "load:dev": "bun scripts/load-into-chrome.ts .output/chrome-mv3-dev"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
