{
  "manifest_version": 3,
  "name": "DSH Tab Switcher",
  "version": "1.0.0",
  "description": "一键激活并精准切换至本地 DeepSeek Harness 标签页 (127.0.0.1:11111)，杜绝其他 DeepSeek 网页干扰",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "点击切换至 DeepSeek Harness"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "switch-to-dsh": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "windows": "Ctrl+Shift+9"
      },
      "description": "精准切换至 DeepSeek Harness 标签页"
    }
  }
}
